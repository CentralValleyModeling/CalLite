/*************************************
ExportEstimate1_BO.wresl
 
This file defines export levels for each project (SWP,CVP).
Estimates are based on current month delivery and San Luis rule-curve.

*/

!*********************************************************************************************
! SWP exports:

! export for south-of-delta SWP: demand
define EstSWPSodDem {value swp_total_demand - I_Kern } !Ryan 8/9/2005
define exp_est_SWPDem {alias EstSWPSodDem kind 'EXPORT-ESTIMATE' units 'CFS'}

! export for south-of-delta SWP: rulecurve
define EstSWPSodRC {value SWPRULEcalc1*taf_cfs - S_SLUIS_SWP(-1)*taf_cfs}
define exp_est_SWPRC {alias EstSWPSodRC kind 'EXPORT-ESTIMATE' units 'CFS'}

! New code for working with FWS and NMFS BO Delta Actions
define EstSWPMaxExp_RPA {select estimate from ExportEstimate_SWP where month = month }

! export for south-of-delta SWP: demand + rulecurve
define est_oro_release{
    case verylow {condition S_OROVL[PRESETUP] <= 1250.0 
    value 300.0}
    case low {condition S_OROVL[PRESETUP]>1250.0 .and. S_OROVL[PRESETUP] <= 1800.0 
    value  0.25*(S_OROVL(-1) - 1600. - DrainTar_buffer)*taf_cfs}
    case high {condition S_OROVL[PRESETUP]>1800.0 .and. S_OROVL[PRESETUP] <= 2200.0 
    value 0.50*(S_OROVL(-1) - 1600. - DrainTar_buffer)*taf_cfs}
    case veryhigh { condition always 
    value 0.75*(S_OROVL(-1) - 1600. - DrainTar_buffer)*taf_cfs}
}
define EstSWPSodExp {
! constrain to EstSWPMaxExp_RPA for cases where FWS and NMFS BO Delta Actions control ALL exports from Delta
    case noIF{
    condition int(IF_SWPorCVP_OnOff) == 0
    value min(BanksMaxAllow, max(300.0, EstSWPSodDem + EstSWPSodRC), EstSWPMaxExp_RPA, max(300.,est_oro_release))
    }
! If there is another intake (Isolated Facility ND intake) do not constrain
!    case withIF{   !Commenting out IF condition (from CalSim 3) until that code is developed -TF Stantec 090722
!    condition always
!        value min(BanksMaxAllow, max(300.0, EstSWPSodDem + EstSWPSodRC), max(300.,est_oro_release))
!    }
}


define exp_est_SWP {alias EstSWPSodExp kind 'EXPORT-ESTIMATE' units 'CFS'}
define exp_estSWPlim3  {alias max(300.,est_oro_release) kind 'debug' units 'cfs'}

!*********************************************************************************************
! CVP exports:
! This calculation is considering both potential ND intake as well as SD intake - see ExportEstimate2.wresl

! export for south-of-delta CVP: demand
if int(Dynamic_SJR)==1 {define MP_Delivs {value min(C_SJR205[Upstream_DySJR]+C_FSL005[Upstream_DySJR], 
        D_MDOTA_73_XA[Upstream_DySJR] + D_MDOTA_90_PA1[Upstream_DySJR] 
      + D_MDOTA_91_PA[Upstream_DySJR] + D_MDOTA_91_PR[Upstream_DySJR] 
      + D_MDOTA_64_XA[Upstream_DySJR] + D_MDOTA_XCC010[Upstream_DySJR] 
      + (D_SJR180_ARY010[Upstream_DySJR]-R_64_XA_SJR185[Upstream_DySJR]))}}

if int(Dynamic_SJR)==0 {
    define C_SJR205_TS         {timeseries 'C_SJR205' kind 'CHANNEL' units 'CFS'}
	define C_FSL005_TS         {timeseries 'C_FSL005' kind 'CHANNEL' units 'CFS'}
	define D_MDOTA_73_XA_TS    {timeseries 'D_MDOTA_73_XA' kind 'DIVERSION' units 'CFS'}
	define D_MDOTA_90_PA1_TS   {timeseries 'D_MDOTA_90_PA1' kind 'DIVERSION' units 'CFS'}
	define D_MDOTA_91_PA_TS    {timeseries 'D_MDOTA_91_PA' kind 'DIVERSION' units 'CFS'}
	define D_MDOTA_91_PR_TS    {timeseries 'D_MDOTA_91_PR' kind 'DIVERSION' units 'CFS'}
	define D_MDOTA_64_XA_TS    {timeseries 'D_MDOTA_64_XA' kind 'DIVERSION' units 'CFS'}
	define D_MDOTA_XCC010_TS   {timeseries 'D_MDOTA_XCC010' kind 'DIVERSION' units 'CFS'}
	define D_SJR180_ARY010_TS  {timeseries 'D_SJR180_ARY010' kind 'DIVERSION' units 'CFS'}
	define R_64_XA_SJR185_TS   {timeseries 'R_64_XA_SJR185' kind 'RETURN-FLOW' units 'CFS'}
	define MP_Delivs {value min(C_SJR205_TS+C_FSL005_TS, 
        D_MDOTA_73_XA_TS + D_MDOTA_90_PA1_TS 
      + D_MDOTA_91_PA_TS + D_MDOTA_91_PR_TS 
      + D_MDOTA_64_XA_TS + D_MDOTA_XCC010_TS 
      + (D_SJR180_ARY010_TS-R_64_XA_SJR185_TS))}}

define EstCVPSodDem {value
  dem_totcvps_pag*taf_cfs*perdel_cvpag_s 
+ dem_totcvps_pls*taf_cfs
+ dem_totcvps_pmi*taf_cfs*perdel_cvpmi_s  
+ dem_totcvps_pex*taf_cfs*perdel_cvpex_s 
+ dem_totcvps_prf*taf_cfs*perdel_cvprf_s 
- MP_Delivs}

define exp_est_CVPDem {alias EstCVPSodDem kind 'EXPORT-ESTIMATE' units 'CFS'}

! export for south-of-delta CVP: rulecurve
define EstCVPSodRC {value CvpRuleCalc1*taf_cfs - S_SLUIS_CVP(-1)*taf_cfs}
define exp_est_CVPRC {alias EstCVPSodRC kind 'EXPORT-ESTIMATE' units 'CFS'}

! minimum Jones pumping
define JonesMinPumpLevel {
        case JonesShastaLow {
                condition S_Shsta(-1) + S_ShstaE(-1) < 1500.0
                value 600.0 }
        case Joneslowshastafolsom {
                condition S_Folsm(-1) < 400. .and. S_Shsta(-1) + S_ShstaE(-1) < 2000. !Better reflection of actual operations by trying to keep
                value 800.  }                                                           !water from being released for SL storage during low storage
        case JonesShastaHigh {
                condition always
                value 800.0 }
}
! export for south-of-delta CVP: demand + rulecurve
define CVPexportcap {value maxJonescalc+ CVPDedBanksSwitch*BanksMaxAllowCVP}

! New code for working with FWS and NMFS BO Delta Actions
define EstCVPMaxExp_RPA {select estimate from ExportEstimate_CVP where month = month }

define EstCVPSodExp { 
    case noIF{
        condition JonesIFSwitch == 0 .and. BanksIFSwitch == 0
        value min(CVPexportcap, max(JonesMinPumpLevel, EstCVPSodDem + EstCVPSodRC), EstCVPMaxExp_RPA )
	}
! If there is another intake (Isolated Facility ND intake) do not constrain
    case IFCase{
        condition always
        value     min(CVPexportcap, max(JonesMinPumpLevel, EstCVPSodDem + EstCVPSodRC))
    }
}

define exp_est_CVP {alias EstCVPSodExp kind 'EXPORT-ESTIMATE' units 'CFS'}
