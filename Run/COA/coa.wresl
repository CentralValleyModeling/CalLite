     case AprMay {
        condition      range(month,apr,may) .and. VAMP_DLTSW == 1 .and. 
                       NDOI_ADD_SWP[PRESETUP] + NDOI_ADD_CVP[PRESETUP] > 0.1 .and. 
                       aprmayexpctrl[PRESETUP] - EXP_TD[PRESETUP] < 0.01
