! Main WRESL Files contains the paths to run the model.
!Date Modified: 04/23/2010; By: Hao Xie
! 5/18/10 Added logic for two cycles to accommodate daily weir flows Tom FitzHugh BOR
! comment out daily weir flows for corroboration study; Richard Chen DWR
! 4/25/11 Cleanup Codes to remove CS2CL,CL, and change Ave to AVG. Richard Chen, DWR
! 9/28/12 Add shortage code, Z.Q. Richard Chen, DWR
! 2/01/13 Changed all includes to local and added dynamic SJR Tom FitzHugh BOR
! 9/16/13 Added D-1485 code. Holly Canada DWR

! All variables are local in wresl+ parser 

initial {
	svar JPOD_ON {select Option from GUI_Operations where Index=2}
	svar PBwheel_ON {select Option from GUI_Operations where Index=4}  !D-1485 
	svar DCC_DLTSW {select OPTION from GUI_Regs where Index = 1}
	svar EI_DLTSW {select OPTION from GUI_Regs where Index = 2}
	svar NDO_DLTSW {select Option from GUI_Regs where Index = 3}
	svar AN_DLTSW {select OPTION from GUI_Regs where Index = 12}  !D-1485
	svar CH_DLTSW {select OPTION from GUI_Regs where Index = 13}  !D-1485
    svar Dynamic_SJR {select Option from GUI_SJR where Index=7} !Turns on dynamic SJR       
    svar LOD_DLTSW {select Option from GUI_HydroClimate where Index=1} 
    svar SLR_DLTSW {select Option from GUI_HydroClimate where Index=3}
	
	svar JonesIFSwitch   {value 0}
	svar BanksIFSwitch   {value 0}
	svar CCWDIFSwitch    {value 0}
	svar LVEM_switch	 {select Option from GUI_LosVaqueros where Index = 1}
	svar AllocationSwitch   {select Option from GUI_Operations where Index=5} !Allocation method
	
	svar RUFRmax {value 0.0} 
	svar simulateDelta_Srplscycle {value 0} ! Assume 0 unless more accurate Delta surplus conditions for COA are needed. Turning on adds about 3 min to runtime

svar LODflag {value 0.}!0 for existing conditions (historical/validation runs); 1 for buildout/future conditions

! Switches for use of new WQ certifications MIFs or Old FERC Licenses (Default: 0 for existing values,1 for New WQ requirements)
svar P2088_WQCFlag 		{value 0.}		!FERC Project P-2088 
svar P2105_WQCFlag 		{value 0.}		!FERC Project P-2105 
svar P619_WQCFlag 		{value 0.}		!FERC Project P-619 
svar P803_WQCFlag 		{value 0.}		!FERC Project P-803 
svar P2266_WQCFlag 		{value 0.}		!FERC Project P-2266 
svar P2246_WQCFlag 		{value 0.}		!FERC Project P-2246  (issued in July 2020)

svar simulateUpperFeather     {value 0.}
svar simulateupperYubaBear    {value 0.} 
svar simulatelowerYuba        {value 0.}
svar simulateUpperAmerican    {value 0.}
svar simulateupperMokelumne   {value 0.}
svar simulatelowerMokelumne   {value 0.} !Set to zero if simulating Sac/SJ valleys. Seepage estimates from EBMUD
svar simulateupperStanislaus  {value 0.}
svar simulateupperTuolumne    {value 0.} ! Under construction
svar simulateSanJoaquinValley {value 1.} !Includes lower Mokelumne but uses GW dll for seepage estimates
svar simulateSacramentoValley {value 1.} 
svar simulateGroundWaterSeepage{value 0.}
		
}

SEQUENCE CYCLE1 {
    model   FAM
    condition month>=Jan .and. month<=May .and. AllocationSwitch==2
    order   1
	}
SEQUENCE CYCLE2 {  
    model   SWPForecast
    condition month>=Jan .and. month<=May 
    order   2
    }   
SEQUENCE CYCLE3 {  
    model   Forecast2
    !condition simulateSanJoaquinValley >= 0.5
    order   3
    }  
     
SEQUENCE CYCLE4 {
    model   SJRBASE_GW4
    condition int(Dynamic_SJR)==1
    order   4
    }
SEQUENCE CYCLE5 {
    model   SJR_WQ1
    condition int(Dynamic_SJR)==1
    order   5
    }
SEQUENCE CYCLE6 {
    model   SJR_PULSE
    condition (month==APR .or. month==MAY) .and. int(Dynamic_SJR)==1
    order   6
    }
SEQUENCE CYCLE7 {
    model   SJR_WQ2
     condition (month==APR .or. month==MAY) .and. int(Dynamic_SJR)==1
    order   7
    }  
SEQUENCE CYCLE8 {
    model   Upstream_DySJR
    condition int(Dynamic_SJR)==1
    order   8
    }
SEQUENCE CYCLE9 {
    model   PRESETUP
    order   9
    }      
    
! Currently running only up to PRESETUP. To enable the rest of the cycle, comment out the blocl
! Daily1, Daily2, and Transfers should remain disabled    
SEQUENCE CYCLE10 {
    model   BASE
    order   10
    }
SEQUENCE CYCLE11 {
    model   DELTA_SRPLS
    condition simulateDelta_Srplscycle >= 0.5
    order   11}
SEQUENCE CYCLE12 {
    model   B2_BO
    order   12
    }     
!SEQUENCE CYCLE9 {
!    model   Daily1
!    order   9
!    }    
!SEQUENCE CYCLE10 {
!    model   Daily2
!    order   10
!    }
!
!SEQUENCE CYCLE10 {
!    model   Transfers
!    order   10
!    }
SEQUENCE CYCLE13 {
    model   Wheeling
    order   13
    }

SEQUENCE CYCLE14 {
    model   ITP
    order   14
    }    
  
    
