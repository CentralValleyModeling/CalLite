group Tdomain {

    ! Define start month and start water year
  	define beginwateryear { value 1922 }!SP MBK
   	define bgnWY {value beginWaterYear} !SP MBK
   	define EndWY {value 2015} !SP MBK
    define BgnMo {value OCT}
    
    define SGPHIGH {value 77777}

    ! Conversion factors   
    define daysindv    { alias daysin    kind 'DAYS'          units 'days'}
    define cfs_cfm     { value daysin * 86400.0}
    define taf_cfm {value 43560*1000}  !AF/month to ft^3/month
    !define af_cfs {value 43560/(86400*daysin)} !3600*24=86400
    define cfs_cfmp    { case first{
                              condition wateryear == BgnWY .and. month == Oct
                              value     daysin * 86400.0}
                         case other{
                              condition always
                              value     daysindv(-1) * 86400.0 } }
    }

group Common_All {
    include 'CVGroundwater\CalSim3GWregionIndex.wresl' !@zrc 2018.10.24
    include '_alt\Other\NewFacilitySwitches.wresl'
    include '_alt\NorthOfDelta\Sacramento\NODOS\NODOS_JobControl.wresl'
    include '_alt\Other\wytypes\WyTypesGeneral.wresl'
    include '_alt\Other\CAAFramework\LCPSIM\LCPSIM_Defines.wresl'
!    include '_alt\Other\CAAFramework\LCPSIM\LCPSIM_to_CALSIM_linkage.wresl'
    
    include '_alt\SanJoaquin\Merced\Merced_Min.wresl' ! Defines minimum flow requirements in Merced River
    
    if simulateGroundWaterSeepage > 0.5 {
    include '_alt\System\System_SJR.wresl' }
    if simulateGroundWaterSeepage < 0.5 {
    include '_alt\System\System_SJR_TS.wresl' }
    include '_alt\SanJoaquin\IntegratedOperations\IntegratedOperationsCommon1.wresl' 
    include 'CVGroundwater\CVGroundwater_ExtFuncs.wresl'
    include '_alt\NorthOfDelta\hydrology\forecast\forecast.wresl'
    include '_alt\System\System_Sac_cycle1.wresl'

    !include 'DeliveryLogic\CvpDeliveryLogic.wresl'                            
    include '_alt\SanJoaquin\Various\definitions\SJR_ChannelSplits.wresl'

    !include 'SanJoaquin\Friant\SJRR_Rest_off.wresl'
    include '_alt\SanJoaquin\Friant\SJRR_Rest.wresl'                     !Turns on SJRR Operations  
    !include 'SanJoaquin\SanJoaquinCore.wresl'
 
    !include 'NorthOfDelta\Sacramento\NODOS\SOD\NODOS_L4Refuge_SOD.wresl'
    include '_alt\SanJoaquin\WastewayOps.wresl'
    include '_alt\SanJoaquin\IntegratedOperations\IntegratedOperationsCommon2.wresl'
    include '_alt\SanJoaquin\IntegratedOperations\IntegratedOperationsCyc1.wresl'    
    include '_alt\System\SystemTables_SJRWest\Weight-table.wresl'
    include '_alt\System\SystemTables_SJREast\Weight-table.wresl'
    include '_alt\DeliveryLogic\Output\deliv_short_cvp_s_sjrcyc.wresl'

    define VampExpCapOn {value 0.}
    define PulseExpRes {value 99999.}
    define PulseExpResdv {std kind 'export' UNITS 'CFS'}
    goal save_PulseExpRes {PulseExpResdv = PulseExpRes}
    
    include '_alt\Other\TUCP_est.wresl'     !set variables for allowing extreme dry year relaxation of criteria
    include '_alt\Other\DCD_Delta.wresl'    !@Idy 10/8/2019 to input DCD data
    }

group Common_DeltaES {
        include[local] '..\run\_alt\System\System_LowerMokelumne_VF.wresl'
        include[local] '..\run\_alt\SanJoaquin\LowerMokelumne\Mok_Ops.wresl'
        include[local] '..\run\_alt\SanJoaquin\Cosumnes\WR_RanchoMurieta.wresl'
        include[local] '..\run\_alt\SanJoaquin\Jackson\LakeAmadorOps.wresl'
        include[local] '..\run\_alt\System\SystemTables_LowerMokelumne\Weight-table.wresl'
}       

MODEL block2 {
	 
	define IF_OnOff {value max(0.,JonesIFSwitch,BanksIFSwitch,CCWDIFSwitch)}
	define IF_SWPorCVP_OnOff {value max(0.,JonesIFSwitch,BanksIFSwitch)}

    INCLUDE '\Assumptions\Options_Switches.wresl'
    
    if int(Dynamic_SJR)==0 { INCLUDE '\sanjoaquin\Timeseries_SJR_Setup.wresl' }     
	if int(Dynamic_SJR)==1 {INCLUDE '\sanjoaquin\Dynamic_SJR_Setup_cyc6_CSLink.wresl'}
	
    include '_alt\Other\wytypes\WyTypesGeneral.wresl'
    include '_alt\SanJoaquin\Various\definitions\previous_wyt_SJR.wresl'

}

MODEL block2_ITP {
	 
	define IF_OnOff {value max(0.,JonesIFSwitch,BanksIFSwitch,CCWDIFSwitch)}
	define IF_SWPorCVP_OnOff {value max(0.,JonesIFSwitch,BanksIFSwitch)}

    INCLUDE '\Assumptions\Options_Switches.wresl'
    
    if int(Dynamic_SJR)==0 { INCLUDE '\sanjoaquin\Timeseries_SJR_Setup_ITP.wresl' }     
	if int(Dynamic_SJR)==1 {INCLUDE '\sanjoaquin\Dynamic_SJR_Setup_cyc6_CSLink_ITP.wresl'}
	
    include '_alt\Other\wytypes\WyTypesGeneral.wresl'
    include '_alt\SanJoaquin\Various\definitions\previous_wyt_SJR.wresl'

}

MODEL block3 {
    define getFinalMrdo {EXTERNAL f90}  ! OBJ code file must be located in run\external directory for compilation

    if banksifswitch > 0.5 .or. jonesifswitch > 0.5 {
		INCLUDE  'Delta\DeltaExtFuncs_7inpANN_roa25_slr0.wresl'} 
	elseif int(SLR_DLTSW)==0{
		INCLUDE  'Delta\DeltaExtFuncs_7inpANN_roa0_slr0.wresl'}
	elseif int(SLR_DLTSW) == 1{
    	INCLUDE  'Delta\DeltaExtFuncs_7inpANNslr15cm.wresl'} 
    elseif int(SLR_DLTSW) == 2{
    	INCLUDE  'Delta\DeltaExtFuncs_7inpANNslr45cm.wresl'} 

    INCLUDE  '_alt\DeLiveryLogic\SWP\allocation\co_extfcn.wresl'

    INCLUDE 'System\System.wresl'
    include '_alt\NorthOfDelta\hydrology\forecast\forecast.wresl'
}

