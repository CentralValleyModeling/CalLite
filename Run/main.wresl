MODEL block6 { ! Only difference with block5 is export_ops file called
    include '_alt\System\System_SJR_TS_forfullsys.wresl' 
    if simulateGroundWaterSeepage > 0.5 {
    include 'CVGroundwater\CVGroundwater_iter4Post.wresl' }
    if simulateGroundWaterSeepage < 0.5 {  	
