! East Bay MUD
define  DN_EBMUD        {std kind 'SW_DELIVERY-NET' units 'CFS'}            
define  DG_EBMUD        {std kind 'SW_DELIVERY-GROSS' units 'CFS'}
!define  UD_EBMUD            {timeseries kind 'URBAN-DEMAND' units 'TAF' convert 'CFS'}
!define  UD_EBMUD_HISTORICAL {timeseries kind 'URBAN-DEMAND' units 'TAF' convert 'CFS'} 
!define  UD_EBMUD_2015LOD    {timeseries kind 'URBAN-DEMAND' units 'TAF' convert 'CFS'}

define AnnualEBMUD      {value  195} !mgd. Approximate avareg annual demand 
define distEBMUD        {select EBMUD from Mok_demands where month=month}
define UD_EBMUD         {value AnnualEBMUD * 1.1201485 * distEBMUD * taf_cfs}





