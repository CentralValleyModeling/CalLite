!South of Delta
!James Bypass flows into the Mendota Pool
if int(Dynamic_SJR)==1 {
define AD_JamesBP     {std kind 'FLOW-ACCRDEPL' units 'CFS'}
goal setAD_JamesBP {AD_JamesBP = C_FSL005[Upstream_DySJR]}}

if int(Dynamic_SJR)==0 {
define AD_JamesBP     {std kind 'FLOW-ACCRDEPL' units 'CFS'}
define AD_JamesBPset {timeseries 'AD_JamesBP' kind 'FLOW-ACCRDEPL' units 'CFS'}
goal setAD_JamesBP {AD_JamesBP = AD_JamesBPset}
}
