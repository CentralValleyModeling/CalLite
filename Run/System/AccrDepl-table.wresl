define c_klryol_CL {timeseries kind 'CHANNEL' units 'CFS'}


goal setAD_CBDrain {AD_CBDrain + D_CBD028_08S_PA  + D_CBD037_08S_PR  + D_CBD049_08N_PA  - R_07N_PA_CBD044 - R_07S_PA_CBD028 - R_08N_PA_CBD044 - R_08N_PR1_CBD049 - R_08N_PR2_CBD044 - R_08N_SA1_CBD044 - R_08N_SA2_CBD049 - R_08S_PA_CBD012 - R_08S_PR_CBD031
-	R_08S_SA1_CBD031 -	R_08S_SA2_CBD037 = AD_ColusaBasin_other }

goal setAD_CBDrainSac  {AD_CBDrainYolo < c_klryol_CL}
goal setAD_CBDrainYolo {AD_CBDrainSac + AD_CBDrainYolo - AD_CBDrain = 0.}


