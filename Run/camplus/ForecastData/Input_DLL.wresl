!This file defines all the input data to used in the CAM Forecast DLL

!define IYPOS1 {select PA_Start from PA_switch where factor = 1}
define IYPOS1 {value wateryear}
define IYPOS2 {value IYPOS1 + 1}
define IYPOS {case first {
                condition wateryear == IYPOS1
                value IYPOS1}
              case second {
                condition always
                value IYPOS2}}  
define IMPOS {case OCT_DEC {
                condition month <= DEC
                value month + 9}
              case Rest {
                condition always
                value month - 3}}
define IYEAR {value wateryear}
/*define IYEAR {case first {
                condition wateryear == IYPOS1
                select FirstRandYear from RandomYearTable where PA_Sequence = 1}
              case second {
                condition always
                select SecondRandYear from RandomYearTable where PA_Sequence = 1}}  */
define IM {case OCT_DEC {
             condition month <= DEC
             value month + 9}
           case Rest {
             condition always
             value month - 3}}
define IFREQOD_1 {select IFREQOD from Freq_Exceedence where Cat = 1}
define IFREQ1_1 {select IFREQ1 from Freq_Exceedence where Cat = 1}
define IFREQ2_1 {select IFREQ2 from Freq_Exceedence where Cat = 1}
define IFREQ3_1 {select IFREQ3 from Freq_Exceedence where Cat = 1}
define IFREQ4_1 {select IFREQ4 from Freq_Exceedence where Cat = 1}
define IFREQ5_1 {select IFREQ5 from Freq_Exceedence where Cat = 1}

define IFREQOD_2 {select IFREQOD from Freq_Exceedence where Cat = 2}
define IFREQ1_2 {select IFREQ1 from Freq_Exceedence where Cat = 2}
define IFREQ2_2 {select IFREQ2 from Freq_Exceedence where Cat = 2}
define IFREQ3_2 {select IFREQ3 from Freq_Exceedence where Cat = 2}
define IFREQ4_2 {select IFREQ4 from Freq_Exceedence where Cat = 2}
define IFREQ5_2 {select IFREQ5 from Freq_Exceedence where Cat = 2}

define IFREQOD_3 {select IFREQOD from Freq_Exceedence where Cat = 3}
define IFREQ1_3 {select IFREQ1 from Freq_Exceedence where Cat = 3}
define IFREQ2_3 {select IFREQ2 from Freq_Exceedence where Cat = 3}
define IFREQ3_3 {select IFREQ3 from Freq_Exceedence where Cat = 3}
define IFREQ4_3 {select IFREQ4 from Freq_Exceedence where Cat = 3}
define IFREQ5_3 {select IFREQ5 from Freq_Exceedence where Cat = 3}

define SQKS_0_1 {case JAN {
                   condition month <= JAN
                   value 0.0}
                 case rest {
                   condition always
                   value C_KSWCK(prevJAN)*cfs_taf(prevJAN)}}
define SQKS_0_2 {case FEB {
                   condition month <= FEB
                   value 0.0}
                 case rest {
                   condition always
                   value C_KSWCK(prevFEB)*cfs_taf(prevFEB)}}
define SQKS_0_3 {case MAR {
                   condition month <= MAR
                   value 0.0}
                 case rest {
                   condition always
                   value C_KSWCK(prevMAR)*cfs_taf(prevMAR)}}
define SQKS_0_4 {case APR {
                   condition month <= APR
                   value 0.0}
                 case rest {
                   condition always
                   value C_KSWCK(prevAPR)*cfs_taf(prevAPR)}}
define SQKS_1_1 {case first {
                   condition wateryear == 1922
                   select SQKS from HistoricFlow where month = 13}
                 case second {
                   condition always
                   value C_KSWCK(-8-month)*cfs_taf(-8-month)}}  
define SQKS_1_2 {case first {
                   condition wateryear == 1922
                   select SQKS from HistoricFlow where month = 14}
                 case second {
                   condition always
                   value C_KSWCK(-7-month)*cfs_taf(-7-month)}}  
