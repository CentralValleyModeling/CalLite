define PSH_0_1 {case JAN {
                   condition month <= JAN
                   value 0.0}
                 case rest {
                   condition always
                   value PPT_SHAS(prevJAN)}}
define PSH_0_2 {case FEB {
                   condition month <= FEB
                   value 0.0}
                 case rest {
                   condition always
                   value PPT_SHAS(prevFEB)}}
