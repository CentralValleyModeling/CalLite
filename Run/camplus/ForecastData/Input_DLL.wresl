define SQKS_1_10 {case first {
                    condition wateryear == 1922
                    value 0.0}
                  case second {
                    condition always
                    value C_KSWCK(prevOCT)*cfs_taf(prevOCT)}}
define SQKS_1_11 {case first {
                    condition wateryear == 1922 .and. month<=Dec
                    value 0.0}
                  case second {
                    condition always
                    value C_KSWCK(prevNOV)*cfs_taf(prevNOV)}}
