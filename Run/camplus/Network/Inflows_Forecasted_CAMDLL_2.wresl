SQFP_1_7,SQFP_1_8,SQFP_1_9,SQFP_1_10,SQFP_1_11,SQFP_1_12,SQFP_2_10,SQFP_2_11,SQFP_2_12,
SQSW_0_1,SQSW_0_2,SQSW_0_3,SQSW_0_4,SQSW_1_1,SQSW_1_2,SQSW_1_3,SQSW_1_4,SQSW_1_5,SQSW_1_6,
SQSW_1_7,SQSW_1_8,SQSW_1_9,SQSW_1_10,SQSW_1_11,SQSW_1_12,SQSW_2_10,SQSW_2_11,SQSW_2_12,
