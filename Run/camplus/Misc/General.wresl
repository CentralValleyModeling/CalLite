
define fm {
	case OctToDec{
		condition month<=3
       		value 3-month
       	}
       	case JanToSep{
		condition month>3
			value 15-month
	}
}

define fm_dv{std kind 'count' units 'none'}
goal setfm_dv{fm_dv=fm}

define(fm) mv{
	Case Sep{
		condition (month+$m)/12.0==int((month+$m)/12.0)
		value 12
	}
	Case OctToAug{
		condition always
		value (month+$m)-int((month+$m)/12.0)*12
	}
}

define monthFromJan{
	case JanSep{
		condition month>=4
		value Jan-month
	}	
	case OctDec{
		condition always
		value Jan-month-12
	}
}

define(fm) wy{
	value int((month+$m-1)/12.)+wateryear
}
!
define C_KSWCK  {lower 0 upper 99999 kind 'FLOW-CHANNEL' units 'CFS'}
define C_FTR059 {lower 0 upper 210000 kind 'CHANNEL' units 'CFS'}
define	SP_SAC083_YBP037	{std kind 'RIVER-SPILLS' units 'CFS'}
define C_SAC049 {lower 0 upper 110000 kind 'CHANNEL' units 'CFS'} 
define	SP_SAC066_YBP020	{std kind 'RIVER-SPILLS' units 'CFS'}
define C_NTOMA	{std kind 'CHANNEL' units 'CFS'}
