! FixedDeliveries.wresl
! Diversions fixed to the WHEELJPOD cycle

!Trinity R blw Lewiston
goal fixC_LWSTN {lhs C_LWSTN rhs C_LWSTN[WHEELING] lhs>rhs penalty 999999 lhs<rhs penalty 999999}

!Sacramento River upstream of Red Bluff 
goal fixC_WKYTN {lhs C_WKYTN rhs C_WKYTN[WHEELING]}  
goal fixC_KSWCK {lhs C_KSWCK rhs C_KSWCK[WHEELING]} ! Shasta storage/releases have been observed to change in ITP cycle. This should not happen in the ITP cycle so hard constraint is used.
goal fixC_REDBLF {lhs C_REDBLF rhs C_REDBLF[WHEELING]}

!Sacramento River at Wilkins Slough
goal fixC_Wilkns {lhs C_Wilkns rhs C_Wilkns[WHEELING]}

!Feather/ Yuba River
goal fixC_OROVL {C_OROVL = C_OROVL[WHEELING] + release_ITP_Carryover + SMSCG_Oro_Rel_for_DO - Alt2BSWPExpCut_Carryover + remain_ITP_Carryover_Oro_rel*taf_cfs} ! Oroville release
goal fixC_Therm {C_Therm = C_Therm[WHEELING] + release_ITP_Carryover + SMSCG_Oro_Rel_for_DO - Alt2BSWPExpCut_Carryover + remain_ITP_Carryover_Oro_rel*taf_cfs } !below Thermalito return
goal fixC_YubFea {C_YubFea = C_YubFea[WHEELING] + release_ITP_Carryover + SMSCG_Oro_Rel_for_DO - Alt2BSWPExpCut_Carryover + remain_ITP_Carryover_Oro_rel*taf_cfs} ! at the mouth

!American River
goal fixC_Nimbus {lhs C_Nimbus rhs C_Nimbus[WHEELING]}
goal fixC_HSt {lhs C_HSt rhs C_HSt[WHEELING]}    ! at the mouth

!Lower Sacramento River
goal fixC_SACFEA {lhs C_SACFEA rhs C_SACFEA[WHEELING] + release_ITP_Carryover + SMSCG_Oro_Rel_for_DO - Alt2BSWPExpCut_Carryover + remain_ITP_Carryover_Oro_rel*taf_cfs} !below Fremont Weir
goal fixC_SACAME {lhs C_SACAME rhs C_SACAME[WHEELING] + release_ITP_Carryover + SMSCG_Oro_Rel_for_DO - Alt2BSWPExpCut_Carryover + remain_ITP_Carryover_Oro_rel*taf_cfs } !below Americaan River
goal fixC_HOOD {lhs C_HOOD rhs C_HOOD[WHEELING] + release_ITP_Carryover + SMSCG_Oro_Rel_for_DO - Alt2BSWPExpCut_Carryover + remain_ITP_Carryover_Oro_rel*taf_cfs} !Sac River inflow into Delta
goal fixC_YOLOBP {lhs C_YOLOBP rhs C_YOLOBP[WHEELING]}  !Yolo Bypass flow

!Delta Inflow
!goal fixC_SACtot_ANN {lhs C_SACtot_ANN rhs C_SACtot_ANN[WHEELING]} 
!goal fixC_MOK019 {lhs C_MOK019 rhs C_MOK019[WHEELING]} 
!goal fixC_CLV004 {lhs C_CLV004 rhs C_CLV004[WHEELING]} 
!goal fixC_SJR070est {lhs C_SJR070est rhs C_SJR070est[WHEELING]} 

!NOD Storages
goal fixS_TRNTY {lhs S_TRNTY rhs S_TRNTY[WHEELING]} ! Prevent changing in the last cycle. Use hard constraint.
goal fixS_SHSTA {lhs S_SHSTA rhs S_SHSTA[WHEELING]} ! Shasta storage/releases have been observed to change in ITP cycle. This should not happen in the ITP cycle so hard constraint is used.
goal fixS_FOLSM {lhs S_FOLSM rhs S_FOLSM[WHEELING]}
!goal fixS_OROVL {lhs S_OROVL rhs S_OROVL[WHEELING] lhs>rhs penalty 999999 lhs<rhs penalty 999999} ! Not needed due to hard constraint on C_OROVL

!Delta Outflow
goal fixD_Jones {D_Jones = D_Jones[WHEELING]}  

goal fixNDOI_MIN {NDOI_MIN = NDOI_MIN[WHEELING]}
goal fixNDOI_ANN {NDOI_ADD_ANN = NDOI_ADD_ANN[WHEELING]}
goal fixNDOI_ADD_CVP {NDOI_ADD_CVP = NDOI_ADD_CVP[WHEELING]}

! If there is remaining ITP Oroville carryover after paying 60 day SMSCG water cost during D following W, AN, push the remaining to delta outflow 
goal fixNDOI_ADD_SWP { NDOI_ADD_SWP = NDOI_ADD_SWP[WHEELING] + Alt2BSWPExpCut_SJRIE + Alt2BSWPExpCut_X2 + Alt2BSWPExpCut_Outflow
			      + release_ITP_Carryover + SMSCG_Oro_Rel_for_DO + remain_ITP_Carryover_Oro_rel*taf_cfs}

!goal fixNDOI_ADD_WTS {NDOI_ADD_WTS = NDOI_ADD_WTS[WHEELING]}	
!goal fixNDOI_ADD_WHLCV {NDOI_ADD_WHLCV = NDOI_ADD_WHLCV[WHEELING]}	
!goal fixNDOI_ADD_WHLJP {NDOI_ADD_WHLJP = NDOI_ADD_WHLJP[WHEELING]}	
/*goal fixNDOI_ADD_ITP {NDOI_ADD_ITP = 0.0}
goal fixNDOI_ADD_VSA {NDOI_ADD_VSA = FriantVA_flow}*/
goal fixNDOI_ADD_SJRR {NDOI_ADD_SJRR = FriantVA_EXC}
