!For dynamic model C_SJRVer computed dynamically
define C_SJRVER {lower 0 upper 99999 kind 'FLOW-CHANNEL' units 'CFS'} !SJR below Vernalis
goal setSJRVER {C_SJRVER = C_SJR070[Upstream_DySJR] + D_SJR070_SJRRremove[Upstream_DySJR]} !SJR below Vernalis

goal setC_MDOTA {C_MDOTA = C_MDOTA[Upstream_DySJR]}

define c_calav {lower 0 upper 99999 kind 'flow-channel' units 'cfs'}  ! calaveras flow into SJR
goal setCALAV {c_calav = C_CLV004[Upstream_DySJR]} !calaveras flow into SJR

!For dynamic model AD_SJRCalALL = C_Calav + AD_SJRCal - D_Calav (which are computed dynamically) this code is in SJR system
define AD_SJRCalALL {std kind 'FLOW-ACCRDEPL' units 'CFS'}

!For timeseries option set AD_SJRCalALL = AD_Calaveras (timeseries from CS2CL)  
define AD_Calaveras {timeseries 'AD_SJRCal' kind 'FLOW-ACCRDEPL' units 'CFS'}
goal setAD_SJRCalALL {lhs AD_SJRCalALL rhs AD_Calaveras+c_calav lhs>rhs penalty 9999. lhs<rhs penalty 9999.}

define AD_SJR_VAMP {value C_SJR070[SJR_WQ1]} 
define AD_SJR_PULSE {value C_SJR070[SJR_WQ2]}

define VernQ {
     case April {
          condition month == apr
          value     C_SJR070[SJR_WQ1]*14./daysin + C_SJR070[SJR_WQ2]*(daysin-14.)/daysin }
     case MayOnly {
          condition month == may
          value     C_SJR070[SJR_WQ2]*15./daysin + C_SJR070[SJR_WQ1]*(daysin-15.)/daysin }
     case otherwise {
          condition always
          value     C_SJR070[SJR_WQ1]}
}

!UNBLOCK THIS LATER WHEN FINISHING UP DYNAMIC SJR
!goal setCVPDMC  {C_CVPDMC = C_DMC116[Upstream_DySJR]}

define I_MDOTA {timeseries kind 'FLOW-INFLOW' units 'TAF' convert 'CFS'} !James Bypass

define VAMP_reqdv_VAMP {value 0.}

define VAMP_reqdv {std kind 'flow-requirement' units 'cfs'}

goal setVAMP_reqdv {VAMP_reqdv = VAMP_reqdv_VAMP}

define Vern_nomincycle6 {value VernQ}

define VernMin_reqtobemet { value AL_VrnMintobemet[Upstream_DySJR]}


define AL_VrnMintobemet {alias VernMin_reqtobemet kind 'temp' units 'cfs'}

define MercedRelease_Oct {value MercedRelease_OctDV[Upstream_DySJR]}

define VernWQfinalSV { value VernWQfinal[Upstream_DySJR]}

