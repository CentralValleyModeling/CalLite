!==============================
! 2_SA -
!==============================
goal setEV_02_SA    {EV_02_SA = D_SAC296_02_SA * EVF_SAC296_02_SA} 
goal setDP_02_SA    {DP_02_SA = D_SAC296_02_SA * DPF_SAC296_02_SA} 
goal setLF_02_SA    {LF_02_SA = D_SAC296_02_SA * LFF_SAC296_02_SA} 
goal setOS_02_SA    {OS_02_SA = D_SAC296_02_SA * OSF_SAC296_02_SA} 
goal setDL_02_SA    {DL_02_SA = EV_02_SA  + DP_02_SA  + LF_02_SA + OS_02_SA}
! reuse
goal setRU_02_SA   {RU_02_SA = min(TW_02_SA, RUFR_02_SA*AWR_02_SA + RUFO_02_SA*AWO_02_SA)} 
goal setAW_02_SA    {AW_02_SA = AWR_02_SA + AWO_02_SA} 
! riparian loss
goal setRP_02_SA    {RP_02_SA = AW_02_SA * RPF_02_SA} 

