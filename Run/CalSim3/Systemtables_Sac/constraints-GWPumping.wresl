! 3_SU
goal setGPmin_03_SU        {GP_03_SU > GPmin_03_SU * UD_03_SU}
!goal setGPmax_03_SU        {GP_03_SU < GPmax_03_SU * UD_03_SU}

! 3_PU1
goal setGPmin_03_PU1        {GP_03_PU1 > GPmin_03_PU1 * UD_03_PU1}
!goal setGPmax_03_PU1        {GP_03_PU1 < GPmax_03_PU1 * UD_03_PU1}

! 3_PU2
goal setGPmin_03_PU2       {GP_03_PU2 > GPmin_03_PU2 * UD_03_PU2}
!goal setGPmax_03_PU2       {GP_03_PU2 < GPmax_03_PU2 * UD_03_PU2}

! 3_PU3
goal setGPmin_03_PU3       {GP_03_PU3 > GPmin_03_PU3 * UD_03_PU3}
!goal setGPmax_03_PU3       {GP_03_PU3 < GPmax_03_PU3 * UD_03_PU3}

goal set_GP_WBATotal_3  {GP_WBATotal_3 	- GP_03_NA - GP_03_SA - GP_03_SU - GP_03_PA - GP_03_PU1 - GP_03_PU2 - GP_03_PU3 - GP_03_NU  = 0.}

