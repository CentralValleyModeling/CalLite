!goal setGPmax_19_SA    {GP_19_SA  < GPmax_19_SA * AWo_19_SA * (1+ RPF_19_SA - RUFo_19_SA) + GPmax_19_SA * AWr_19_SA * (1+ RPF_19_SA - RUFr_19_SA)}
