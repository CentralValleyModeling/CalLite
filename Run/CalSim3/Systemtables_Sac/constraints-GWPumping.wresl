/*
File Name: constraints-GWpumping.wresl
CalSim 3.0 System File

Purpose:

Naming takes the following form:


*/

!Note: Constraints for demand units with no access to surface water are not meaningful.

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!! WBA 1       !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!Not used

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!! WBA 2       !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! 2_PA
goal setGPmin_02_PA        {GP_02_PA > GPmin_02_PA * AWo_02_PA * (1+ RPF_02_PA - RUFo_02_PA) + GPmin_02_PA * AWr_02_PA * (1+ RPF_02_PA - RUFr_02_PA)}
!goal setGPmax_02_PA        {GP_02_PA < GPmax_02_PA * AWo_02_PA * (1+ RPF_02_PA - RUFo_02_PA) + GPmax_02_PA * AWr_02_PA * (1+ RPF_02_PA - RUFr_02_PA)}
define GPmin_02_PA_dv	{alias GPmin_02_PA * AWo_02_PA * (1+ RPF_02_PA - RUFo_02_PA) + GPmin_02_PA * AWr_02_PA * (1+ RPF_02_PA - RUFr_02_PA) kind 'GW-PUMPING-LIMIT' units 'CFS'}

! 2_SA
goal setGPmin_02_SA        {GP_02_SA > GPmin_02_SA * AWo_02_SA * (1+ RPF_02_SA - RUFo_02_SA) + GPmin_02_SA * AWr_02_SA * (1+ RPF_02_SA - RUFr_02_SA)}
!goal setGPmax_02_SA        {GP_02_SA < GPmax_02_SA * AWo_02_SA * (1+ RPF_02_SA - RUFo_02_SA) + GPmax_02_SA * AWr_02_SA * (1+ RPF_02_SA - RUFr_02_SA)}
define GPmin_02_SA_dv	{alias GPmin_02_SA * AWo_02_SA * (1+ RPF_02_SA - RUFo_02_SA) + GPmin_02_SA * AWr_02_SA * (1+ RPF_02_SA - RUFr_02_SA) kind 'GW-PUMPING-LIMIT' units 'CFS'}

! 2_PU
goal setGPmin_02_PU        {GP_02_PU > GPmin_02_PU * UD_02_PU}
!goal setGPmax_02_PU        {GP_02_PU < GPmax_02_PU * UD_02_PU}

! 2_SU
goal setGPmin_02_SU        {GP_02_SU > GPmin_02_SU * UD_02_SU}
!goal setGPmax_02_SU        {GP_02_SU < GPmax_02_SU * UD_02_SU}

goal set_GP_WBATotal_2  {GP_WBATotal_2 - GP_02_NA - GP_02_SA - GP_02_SU - GP_02_PA - GP_02_PU - GP_02_NU=0.}

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!! WBA 3       !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
