! Western Canal closes in mid-January until April and the start of flood-up for rice

define WEC_Open {
  case OctDec {
    condition   month <= DEC
    value      1.0 }
  case AprSep {
    condition   month >=APR
    value       1.0 }
  case JanMar {
    condition   always
    value       0.0 }
}

goal limitD_WEC005_BTC032     {D_WEC005_BTC032 < WRmon_WEC005_BTC032*taf_cfs*WEC_Open}

