define CLmon_WTPCSD_02_PU     {timeseries kind 'CONTRACT-LIMIT' units 'TAF'}
define CLmon_WKYTN_02_PU      {timeseries kind 'CONTRACT-LIMIT' units 'TAF'}
define CLmon_SHSTA_03_PU1     {timeseries kind 'CONTRACT-LIMIT' units 'TAF'}
